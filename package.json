{
  "name": "varg",
  "private": true,
  "version": "0.5.6",
  "type": "module",
  "description": "Varg — a rugged, offline-first military-style workout tracker",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && eslint src && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "bun run scripts/make-icon.ts && tauri icon assets/icon.png",
    "db:generate": "drizzle-kit generate",
    "db:smoke": "bun run scripts/db-smoke.ts",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-sql": "^2",
    "drizzle-orm": "^0.44.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.61.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3"
  }
}